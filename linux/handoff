#!/bin/bash
# claude-on-call: hand a Windows Claude Code conversation to Sesame Link.
#
#   handoff <claude-session-id>      (run in the conversation's folder)
#
# Sesame Link's own /open-sesame does this for Linux/macOS Claude Code: it finds
# the Claude process it was called from (its parent), checks the conversation's
# transcript exists, creates a Link session that resumes the same conversation,
# and ends the original. From Windows the original Claude is a Windows process
# Link cannot see, and the transcript lives under the Windows home. So we:
#   1. copy the Windows transcript to the path Link expects on the Linux side,
#   2. run `sesame-link open-sesame` from inside a placeholder process named
#      `claude` that stands in for the Windows one,
# and the new Link session resumes the conversation through the shim, which runs
# Windows Claude Code with `--resume <id>` in the same folder.
set -u
ONCALL_HOME="${ONCALL_HOME:-$HOME/.claude-on-call}"
# shellcheck disable=SC1090
. "$ONCALL_HOME/config"
export PATH="$HOME/.local/bin:$ONCALL_HOME/bin:$PATH"

SID="${1:-}"
case "$SID" in
    [0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F]-*) ;;
    *) echo "claude-on-call: expected a Claude Code session id, got '${SID}'"; exit 2 ;;
esac

if ! sesame-link status >/dev/null 2>&1; then
    echo "claude-on-call: Sesame Link isn't running. Run: oncall start"; exit 1
fi

# 1. Find the conversation's transcript. Claude Code files it under the folder the
#    session started in, which may differ from the current folder, so search by id.
WIN_TRANSCRIPT="$(ls "$WIN_HOME"/.claude/projects/*/"$SID".jsonl 2>/dev/null | head -1)"
if [ -z "$WIN_TRANSCRIPT" ] || [ ! -s "$WIN_TRANSCRIPT" ]; then
    echo "claude-on-call: couldn't find a transcript for session $SID under"
    echo "  $(wslpath -w "$WIN_HOME")\\.claude\\projects"
    echo "Send one message in the conversation first, then run /oncall again."
    exit 1
fi

# The Link session should live in the folder the conversation was running in, which
# the transcript records. Fall back to the current folder.
CONV_CWD_WIN="$(python3 - "$WIN_TRANSCRIPT" <<'PY'
import json, sys
last = None
for line in open(sys.argv[1], encoding="utf-8", errors="ignore"):
    if '"cwd"' not in line:
        continue
    try:
        d = json.loads(line)
    except Exception:
        continue
    if isinstance(d.get("cwd"), str) and d["cwd"]:
        last = d["cwd"]
print(last or "")
PY
)"
if [ -n "$CONV_CWD_WIN" ]; then
    CONV_CWD="$(wslpath -u "$CONV_CWD_WIN" 2>/dev/null)"
    [ -d "$CONV_CWD" ] && cd "$CONV_CWD"
fi

# Copy it to the Linux path Link expects (a real file, not a symlink).
encode() { printf '%s' "$1" | sed 's/[^A-Za-z0-9]/-/g'; }
LINUX_DIR="$HOME/.claude/projects/$(encode "$PWD")"
LINUX_TRANSCRIPT="$LINUX_DIR/$SID.jsonl"
mkdir -p "$LINUX_DIR"
[ -L "$LINUX_TRANSCRIPT" ] && rm -f "$LINUX_TRANSCRIPT"
cp "$WIN_TRANSCRIPT" "$LINUX_TRANSCRIPT"

# 2. A placeholder "claude" process for Link to find as the caller and end.
#    Link answers open-sesame, then (asynchronously) ends that process and launches
#    the resumed session. If the placeholder has already exited on its own by then,
#    Link treats the conversation as gone and launches nothing, so the placeholder
#    must stay alive until Link ends it (or we clean it up at the end).
DECOY_DIR="$(mktemp -d)"
cat > "$DECOY_DIR/claude" <<'SH'
#!/bin/bash
export PATH="$HOME/.local/bin:$PATH"
# Must stay a child of this "claude" process (no exec): Link checks its parent.
CLAUDECODE=1 CLAUDE_CODE_SESSION_ID="$1" CLAUDE_PID=$$ sesame-link open-sesame > "$2" 2>&1
echo "$?" > "$2.rc"
sleep 120
SH
chmod +x "$DECOY_DIR/claude"
# Session id prefixes from the table (grep, not awk: Ubuntu's mawk lacks {n} quantifiers).
list_ids() { sesame-link sessions 2>/dev/null | grep -oE '^ *[0-9]+ +.*' | grep -oE ' [0-9a-f]{8} ' | tr -d ' '; }
BEFORE=" $(list_ids | tr '\n' ' ') "

"$DECOY_DIR/claude" "$SID" "$DECOY_DIR/out" </dev/null &
DECOY=$!
cleanup() { kill "$DECOY" 2>/dev/null; rm -rf "$DECOY_DIR"; }
trap cleanup EXIT
for _ in $(seq 1 60); do [ -f "$DECOY_DIR/out.rc" ] && break; sleep 0.5; done
cat "$DECOY_DIR/out" 2>/dev/null
RC="$(cat "$DECOY_DIR/out.rc" 2>/dev/null || echo 1)"
[ "$RC" -eq 0 ] || exit "$RC"

# 3. Confirm the new Link session actually appeared before anyone closes the original.
NEW=""
for _ in $(seq 1 25); do
    for id in $(list_ids); do
        case "$BEFORE" in *" $id "*) ;; *) NEW="$id" ;; esac
    done
    [ -n "$NEW" ] && break
    sleep 1
done
if [ -z "$NEW" ]; then
    echo
    echo "WARNING: Sesame Link accepted the hand-off, but no new session has appeared yet."
    echo "Sesame may be unreachable right now (check: oncall status). This conversation stays here."
    exit 3
fi
echo
echo "NEW_SESSION=$NEW"
echo "This conversation now continues in Sesame as session $NEW."
echo "Pick it up at https://link.sesame.com or by voice."
exit 0
